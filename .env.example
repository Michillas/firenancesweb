# ---------- Public site ----------
# Public origin of your deployment (canonical URLs, Open Graph, sitemap, robots). On Vercel it defaults to the
# production domain; set it explicitly anywhere else.
NEXT_PUBLIC_SITE_URL=https://firenances.example.com
# Optional: contact address shown on /privacidad.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------- Optional: server-side AI keys (self-hosted / cloud) ----------
# When set, the /api/ai/* proxy uses them, so the browser does not need its own key.
# They are NEVER sent to the browser. Do not set them on a public deployment without putting auth in front.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
